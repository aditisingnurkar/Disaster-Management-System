CREATE TABLE Disaster (
    disaster_id     INT PRIMARY KEY,
    disaster_type   VARCHAR(100),
    location        VARCHAR(100),
    start_date      DATE,
    end_date        DATE,
    severity_level  VARCHAR(50)
);

CREATE TABLE Shelter (
    shelter_id        INT PRIMARY KEY,
    address           VARCHAR(255),
    capacity          INT,
    coordinator_name  VARCHAR(100),
    disaster_id       INT,
    FOREIGN KEY (disaster_id) REFERENCES Disaster(disaster_id)
);

CREATE TABLE Resource (
    resource_id    INT PRIMARY KEY,
    resource_name  VARCHAR(100),
    description    VARCHAR(255)
);

CREATE TABLE Volunteer (
    volunteer_id  INT PRIMARY KEY,
    name          VARCHAR(100),
    availability  VARCHAR(50)
);

CREATE TABLE Victim (
    victim_id      INT PRIMARY KEY,
    name           VARCHAR(100),
    age            INT,
    contact        VARCHAR(20),
    disaster_id    INT,
    shelter_id     INT,
    medical_needs  VARCHAR(255),
    FOREIGN KEY (disaster_id) REFERENCES Disaster(disaster_id),
    FOREIGN KEY (shelter_id) REFERENCES Shelter(shelter_id)
);

CREATE TABLE Volunteer_Assignments (
    volunteer_id  INT,
    disaster_id   INT,
    role          VARCHAR(100),
    shift_timing  VARCHAR(50),
    PRIMARY KEY (volunteer_id, disaster_id),
    FOREIGN KEY (volunteer_id) REFERENCES Volunteer(volunteer_id),
    FOREIGN KEY (disaster_id) REFERENCES Disaster(disaster_id)
);

CREATE TABLE Volunteer_Skills (
    volunteer_id  INT,
    skill         VARCHAR(100),
    PRIMARY KEY (volunteer_id, skill),
    FOREIGN KEY (volunteer_id) REFERENCES Volunteer(volunteer_id)
);

CREATE TABLE Incident_Report (
    report_id     INT PRIMARY KEY,
    description   VARCHAR(255),
    timestamp     DATETIME,
    volunteer_id  INT,
    disaster_id   INT,
    FOREIGN KEY (volunteer_id) REFERENCES Volunteer(volunteer_id),
    FOREIGN KEY (disaster_id) REFERENCES Disaster(disaster_id)
);

CREATE TABLE Shelter_Inventory (
    shelter_id   INT,
    resource_id  INT,
    quantity     INT,
    PRIMARY KEY (shelter_id, resource_id),
    FOREIGN KEY (shelter_id) REFERENCES Shelter(shelter_id),
    FOREIGN KEY (resource_id) REFERENCES Resource(resource_id)
);

CREATE TABLE Resource_Location (
    resource_id  INT,
    disaster_id  INT,
    shelter_id   INT,
    quantity     INT,
    PRIMARY KEY (resource_id, disaster_id, shelter_id),
    FOREIGN KEY (resource_id) REFERENCES Resource(resource_id),
    FOREIGN KEY (disaster_id) REFERENCES Disaster(disaster_id),
    FOREIGN KEY (shelter_id) REFERENCES Shelter(shelter_id)
);

-- ---------------------------------------------------------
-- "Details" helper tables used by the UI classes
-- ---------------------------------------------------------

CREATE TABLE Incident_Volunteer_Details (
    report_id  INT,
    vol_name   VARCHAR(100)
);

CREATE TABLE Incident_Disaster_Details (
    report_id      INT,
    disaster_type  VARCHAR(100)
);

CREATE TABLE Victim_Shelter_Details (
    victim_id        INT,
    shelter_address  VARCHAR(255)
);

CREATE TABLE Victim_Disaster_Details (
    victim_id      INT,
    disaster_type  VARCHAR(100)
);

CREATE TABLE Volunteer_Assignment_Names (
    volunteer_id  INT,
    name          VARCHAR(100)
);

CREATE TABLE Volunteer_Assignment_Disaster_Types (
    disaster_id    INT,
    disaster_type  VARCHAR(100)
);

CREATE TABLE Shelter_Inventory_Shelter_Details (
    shelter_id       INT,
    shelter_address  VARCHAR(255),
    coord_name       VARCHAR(100),
    disaster_id      INT
);

CREATE TABLE Shelter_Inventory_Resource_Details (
    resource_id    INT,
    resource_name  VARCHAR(100)
);

CREATE TABLE Shelter_Inventory_Disaster_Details (
    shelter_id     INT,
    disaster_id    INT,
    disaster_type  VARCHAR(100)
);

